// Waybar Config File by Arfan Zubi

{
	"layer": "top",
	"height": 40,

	// Load modules
	"include": ["~/.config/waybar/modules.json"],

	"modules-left": ["hyprland/workspaces", "hyprland/window"],
	"modules-center": ["clock"],
	"modules-right": ["group/system", "group/keyboard", "group/hardware", "group/notifications", "tray", "custom/wlogout"],

	"group/system": {
		"orientation": "horizontal",
		"modules": [
			"backlight",
			"pulseaudio",
			"network"
		]
	},

	"group/keyboard": {
		"orientation": "horizontal",
		"modules": [
			"hyprland/language",
			"keyboard-state"
		]
	},

	"group/hardware": {
		"orientation": "horizontal",
		"modules": [
			"disk",
			"cpu",
			"memory",
		]
	},
	"group/notifications": {
		"orientation": "horizontal",
		"modules": [
			"custom/notification"
		]
	},
	"tray": {
		"icon-size": 20
	},
}
